+
+  /**
+   * Linux bridge netfilter applies Docker's internal-subnet DROP even to frames
+   * addressed to a container router. Admit only L2 frames staying on this task's
+   * bridge; host-routed traffic remains subject to Docker isolation, and the
+   * per-task Gateway continues enforcing scope and recording traffic.
+   */
+  private async configureTaskBridgeCompatibility(name: string, enable: boolean): Promise<void> {
+    if (!this.linuxBridgeCompat) return;
+    const inspected = await this.runner(["network", "inspect", "--format", "{{.Id}}", name]);
+    const id = inspected.stdout.trim();
+    if (inspected.code !== 0 || !/^[a-f0-9]{64}$/.test(id)) {
+      throw new Error(`Failed to inspect task bridge for Linux compatibility: ${name}`);
+    }
+    const bridge = `br-${id.slice(0, 12)}`;
+    const rule = [
+      "-i", bridge, "-o", bridge,
+      "-m", "physdev", "--physdev-is-bridged",
+      "-m", "comment", "--comment", `luanniao-task-bridge:${id.slice(0, 12)}`,
+      "-j", "ACCEPT"
+    ];
+    const command = enable
+      ? 'iptables -w 5 -C DOCKER-USER "$@" 2>/dev/null || iptables -w 5 -I DOCKER-USER 1 "$@"'
+      : 'if iptables -w 5 -C DOCKER-USER "$@" 2>/dev/null; then iptables -w 5 -D DOCKER-USER "$@"; fi';
+    const result = await this.runner([
+      "run", "--rm", "--network", "host", "--user", "0",
+      "--cap-drop", "ALL", "--cap-add", "NET_ADMIN",
+      "--security-opt", "no-new-privileges", "--read-only",
+      "--pids-limit", "32", "--memory", "64m",
+      "--entrypoint", "sh", this.image,
+      "-c", command, "luanniao-task-bridge", ...rule
+    ]);
+    if (result.code !== 0) {
+      throw new Error(`Failed to ${enable ? "install" : "remove"} Linux task bridge rule: ${result.stderr || result.stdout}`);
+    }
+  }
